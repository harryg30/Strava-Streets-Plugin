# Copy to `.env` for sideload/dev builds (never commit `.env`).
# Injected at build time into the Dev Key Override adapter only.
# Store/production builds ignore GOOGLE_MAPS_API_KEY.

GOOGLE_MAPS_API_KEY=

# Access Service origin for Store Mint + OAuth (injected into all profiles).
# Must match PUBLIC_ORIGIN / GCP redirect URIs (e.g. http://127.0.0.1:8787).
ACCESS_ORIGIN=http://127.0.0.1:8787
