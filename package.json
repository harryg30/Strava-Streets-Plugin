{
  "name": "strava-streets-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension: Street View beside Strava Route Builder",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs --profile=dev",
    "build:dev": "node scripts/build.mjs --profile=dev",
    "build:store": "node scripts/build.mjs --profile=store",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/google.maps": "^3.58.1",
    "esbuild": "^0.25.0",
    "playwright": "^1.62.1",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
